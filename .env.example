# TraceFleet configuration. Copy to `.env` and edit.
#
#     cp .env.example .env && make up
#
# Every value here is a LOCAL DEMO default. The API refuses to start with
# TRACEFLEET_ENV=production while any of them are still in place.

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
# development | staging | production. In production the API fails fast on the
# insecure defaults below rather than warning.
TRACEFLEET_ENV=development
# dev (2K vehicles) | demo (20K) | full (100K). Selects config/profiles/<x>.yaml.
PROFILE=dev
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DB=tracefleet
POSTGRES_USER=tracefleet
POSTGRES_PASSWORD=tracefleet
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Two roles, deliberately. Row-Level Security is ignored by superusers, by
# BYPASSRLS roles, and by a table's owner -- so an API connecting as the owner has
# RLS enabled and enforcing nothing.
#
#   POSTGRES_URL        the API. Must be the restricted `tracefleet_app` role.
#   POSTGRES_OWNER_URL  migrations, the persister, retention and erasure jobs.
#                       These legitimately operate across every tenant.
#
# GET /api/v1/health reports whether RLS is actually enforced for the API's role.
POSTGRES_URL=postgresql://tracefleet_app:tracefleet_app@postgres:5432/tracefleet
POSTGRES_OWNER_URL=postgresql://tracefleet:tracefleet@postgres:5432/tracefleet
POSTGRES_APP_ROLE=tracefleet_app
POSTGRES_APP_PASSWORD=tracefleet_app

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_STATEMENT_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# ClickHouse
# ---------------------------------------------------------------------------
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=tracefleet

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# Kafka
# ---------------------------------------------------------------------------
KAFKA_BROKER=kafka:9092
KAFKA_COMPRESSION=lz4
KAFKA_LINGER_MS=10

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# RS256. With no key configured the API generates one at startup and caches it in
# JWT_KEY_DIR; it logs a warning because an ephemeral key means tokens do not
# survive a restart and replicas would not share it. Mount a real key for anything
# beyond a local demo:
#   JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem
#   JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem
JWT_KEY_DIR=/var/lib/tracefleet/keys
JWT_ISSUER=https://tracefleet.local/auth
JWT_AUDIENCE=tracefleet-api
JWT_ACCESS_TTL_S=3600
JWT_REFRESH_TTL_S=86400

# Leave false. When true, unauthenticated requests are accepted as a read-only
# VIEWER -- never as an admin.
TRACEFLEET_ALLOW_ANONYMOUS=false

# Seeds admin/manager/analyst/viewer so a fresh clone can log in. Set to false and
# provision real accounts through POST /api/v1/admin/users for any real use.
TRACEFLEET_SEED_DEMO_USERS=true
DEMO_USER_PASSWORD=tracefleet-demo

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_PORT=8000
API_HOST=0.0.0.0

# Allow-list, never `*`. Credentialed requests from any origin is what lets a
# cross-site request act as the logged-in user.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_BURST=120
MAX_REQUEST_BYTES=1048576

# Only enable behind a reverse proxy you control. Otherwise a client can spoof its
# own address into the audit log via X-Forwarded-For.
TRUST_PROXY_HEADERS=false

DEFAULT_TENANT_ID=tenant_default
DEFAULT_FLEET_ID=fleet_default

# ---------------------------------------------------------------------------
# AI narrative layer
# ---------------------------------------------------------------------------
# gemini | mistral | mock | null. Without the selected provider's key, fall back to `mock`,
# a deterministic evidence-derived narrative, so the platform runs fully without a
# key. The response always names the provider that actually ran.
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# ---------------------------------------------------------------------------
# Simulator
# ---------------------------------------------------------------------------
# The control API can publish telemetry, so it is off by default and binds to
# localhost. Enable it for the demo's on-demand incident injection.
SIMULATOR_CONTROL_ENABLED=false
SIMULATOR_CONTROL_HOST=127.0.0.1
SIMULATOR_CONTROL_PORT=8100
SIM_WORKERS=0
GROUND_TRUTH_PATH=artifacts/ground-truth.jsonl

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
OTEL_SERVICE_NAME=tracefleet-api
OTEL_ENVIRONMENT=development
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# Set to true to disable tracing entirely (unit tests, air-gapped runs).
OTEL_SDK_DISABLED=false
PROMETHEUS_URL=http://prometheus:9090
METRICS_PORT=9108

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# ---------------------------------------------------------------------------
# Operations
# ---------------------------------------------------------------------------
# Retention windows live in config/retention.yaml, not here, so the policy is
# reviewable alongside the schema TTL it drives.

# When false, POST /api/v1/ops/chaos returns the command it would run instead of
# executing it, so the API needs no access to the Docker socket.
CHAOS_EXECUTION_ENABLED=false

# The frontend reads these at build time.
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# Root trace sampling; child spans preserve the parent decision.
OTEL_TRACES_SAMPLER_ARG=0.1
