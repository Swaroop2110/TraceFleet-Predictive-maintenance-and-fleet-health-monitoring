{
  "uid": "tracefleet-pipeline",
  "title": "TraceFleet / Pipeline Health",
  "tags": ["tracefleet", "pipeline"],
  "timezone": "utc",
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "description": "Ingest throughput, consumer lag, and data-quality counters. Lag growing while a consumer is paused is back-pressure working, not data loss.",
  "panels": [
    {
      "type": "stat",
      "title": "Accepted events/s",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(rate(tracefleet_events_accepted_total[1m]))", "legendFormat": "accepted" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 1 } }
    },
    {
      "type": "stat",
      "title": "Quarantined events/s",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(rate(tracefleet_events_rejected_total[1m]))", "legendFormat": "rejected" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Duplicates suppressed/s",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(rate(tracefleet_events_duplicated_total[1m]))", "legendFormat": "duplicates" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 } }
    },
    {
      "type": "stat",
      "title": "Total consumer lag",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(tracefleet_consumer_lag)", "legendFormat": "lag" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10000 },
              { "color": "red", "value": 50000 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Paused consumers",
      "description": "A paused consumer means a downstream store is unavailable and Kafka is buffering. Expected during a ClickHouse outage.",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(tracefleet_consumer_paused)", "legendFormat": "paused" }],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Throughput by outcome",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(rate(tracefleet_events_accepted_total[1m]))", "legendFormat": "accepted" },
        { "expr": "sum(rate(tracefleet_events_rejected_total[1m]))", "legendFormat": "quarantined" },
        { "expr": "sum(rate(tracefleet_events_duplicated_total[1m]))", "legendFormat": "duplicates suppressed" },
        { "expr": "sum(rate(tracefleet_events_late_total[1m]))", "legendFormat": "late" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10 } } }
    },
    {
      "type": "timeseries",
      "title": "Consumer lag by group",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (group) (tracefleet_consumer_lag)", "legendFormat": "{{group}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "type": "piechart",
      "title": "Quarantine reasons",
      "description": "A single dominant reason usually means an upstream schema change rather than occasional bad data.",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (reason) (tracefleet_events_rejected_total)", "legendFormat": "{{reason}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Batch processing time p95 by role",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(tracefleet_processing_seconds_bucket[5m])) by (le, role))",
          "legendFormat": "{{role}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "type": "timeseries",
      "title": "Dead-letter and window evictions",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(increase(tracefleet_events_dlq_total[5m]))", "legendFormat": "dead-lettered" },
        {
          "expr": "sum by (reason) (increase(tracefleet_window_evictions_total[5m]))",
          "legendFormat": "evicted ({{reason}})"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "type": "timeseries",
      "title": "Active vehicle windows",
      "description": "Per-vehicle state held in memory by the incident processor, bounded by correlation.max_active_vehicles.",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "tracefleet_active_vehicle_windows", "legendFormat": "windows" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "type": "timeseries",
      "title": "ClickHouse insert latency p95 and failures",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(tracefleet_clickhouse_insert_seconds_bucket[5m])) by (le))",
          "legendFormat": "insert p95"
        },
        {
          "expr": "sum(increase(tracefleet_clickhouse_failures_total[5m]))",
          "legendFormat": "failures"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
